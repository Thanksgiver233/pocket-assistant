# deploy/.env —— 复制为 deploy/.env 后修改；不要提交真实值
#
# 生成令牌：
#   node -e "process.stdout.write(require('crypto').randomBytes(24).toString('base64url'))"

# 访问令牌（≥16 字符）。浏览器首次打开页面时输入它。
PA_TOKEN=CHANGE_ME

# 助手名称（写进 profile，只影响展示）
PA_PERSONA=随身

# 可选：备份桶（backup.sh 使用）
# PA_BUCKET=oss://your-bucket/pa

# 可选：备份保留天数
# PA_BACKUP_KEEP_DAYS=30
