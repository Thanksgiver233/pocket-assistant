{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://piagent.io/schemas/connector.v1.json",
  "title": "pa.connector.v1",
  "description": "Connector declaration. The digest pins what the user consented to; a changed scope means a new consent.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "digest", "tools"],
  "properties": {
    "id": { "type": "string", "minLength": 1, "maxLength": 60 },
    "display_name": { "type": "string", "maxLength": 80 },
    "kind": { "type": "string", "enum": ["mcp", "native", "pack"] },
    "transport": { "type": "object" },
    "auth": { "type": "object" },
    "data_classes": { "type": "array", "items": { "type": "string", "enum": ["D0", "D1", "D2", "D3"] } },
    "reversibility": { "type": "string", "enum": ["full", "partial", "none"] },
    "rate_limit": { "type": "object" },
    "health_check": { "type": "object" },
    "version": { "type": "string" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "tools": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  }
}
